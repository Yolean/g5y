{
  "name": "g5y-noauth",
  "dependencies": {
    "g5y-gateway-api": "*",
    "g5y-sidecar": "file:../../sidecar"
  },
  "devDependencies": {
    "vitest": "3.1.4"
  },
  "scripts": {
    "build:prepare": "mkdir -p target",
    "build:manifests": "P=$(pwd) && cd ../../ && skaffold -p $npm_package_name render --digest-source=tag -a $(skaffold-file-output-merge) -o $P/target/k8s.yaml",
    "build": "npm run build:prepare && npm run build:manifests",
    "setup": "KUBECONFIG=../../teststate/kubeconfig kubectl apply -f target/k8s.yaml",
    "test": "vitest run"
  }
}
